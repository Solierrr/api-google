# Carregado em app/config.py

GOOGLE_KEY_MAPS=
GOOGLE_KEY_TRANSLATION=

# Google Calendar + OAuth 2.0
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=http://localhost:8000/calendar/callback

# JWT RS256 de usuário validado via JWKS do api-auth
JWT_JWKS_URL=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=solaria-auth

# repos solier nativos chamados internamente
AUTH_BASE_URL=http://localhost:8081

# X-Service-Key de cada serviço chamador aceito (mínimo 32 caracteres; vazio recusa o chamador)
SERVICE_KEY_API_CORE=
SERVICE_KEY_AI_GEOGRAPHIC=

# Swagger (/docs) e contrato (/openapi.json); false em PROD
DOCS_ENABLED=true

# Origens do CORS, separadas por vírgula (no QA inclui o web-sandbox)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

#  Ambiente  prod | dev(local)
ENVIRONMENT=dev

# Nível mínimo de log (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# /otel | mesmos nomes do api-core
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=local
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
# OTEL_SDK_DISABLED=true  -> desliga telemetria (testes)
